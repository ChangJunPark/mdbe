{
  "name": "mdbe",
  "version": "0.1.0",
  "version_name": "0.1.0",
  "author": "Bener and mdbe contributors",
  "manifest_version": 3,
  "description": "A local-first Markdown workbench with a folder tree and WYSIWYG editing.",
  "homepage_url": "https://github.com/ChangJunPark/mdbe",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "default_locale": "en",
  "icons": {
    "16": "images/mdbe-logo.png",
    "32": "images/mdbe-logo.png",
    "48": "images/mdbe-logo.png",
    "128": "images/mdbe-logo.png",
    "512": "images/mdbe-logo.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["css/*", "fonts/*", "images/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_title": "mdbe",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "js": ["js/content.js"],
      "css": ["css/content.css"],
      "matches": [
        "*://*/*.md",
        "*://*/*.mdx",
        "*://*/*.mkd",
        "*://*/*.markdown",
        "*://*/*.MD",
        "*://*/*.MDX",
        "*://*/*.MKD",
        "*://*/*.MARKDOWN",
        "file://*/*.md",
        "file://*/*.mdx",
        "file://*/*.mkd",
        "file://*/*.markdown",
        "file://*/*.MD",
        "file://*/*.MDX",
        "file://*/*.MKD",
        "file://*/*.MARKDOWN",
        "*://*/*.md?*",
        "*://*/*.mdx?*",
        "*://*/*.mkd?*",
        "*://*/*.markdown?*",
        "*://*/*.MD?*",
        "*://*/*.MDX?*",
        "*://*/*.MKD?*",
        "*://*/*.MARKDOWN?*",
        "file://*/*.md?*",
        "file://*/*.mdx?*",
        "file://*/*.mkd?*",
        "file://*/*.markdown?*",
        "file://*/*.MD?*",
        "file://*/*.MDX?*",
        "file://*/*.MKD?*",
        "file://*/*.MARKDOWN?*"
      ]
    }
  ],
  "commands": {
    "toggleSide": {
      "description": "__MSG_command_toggle_side__",
      "suggested_key": {
        "default": "Alt+Shift+B"
      }
    },
    "toggleCentered": {
      "description": "__MSG_command_toggle_centered__",
      "suggested_key": {
        "default": "Alt+Shift+C"
      }
    },
    "toggleRefresh": {
      "description": "__MSG_command_toggle_refresh__",
      "suggested_key": {
        "default": "Alt+Shift+R"
      }
    },
    "toggleTheme": {
      "description": "__MSG_command_toggle_theme__",
      "suggested_key": {
        "default": "Alt+Shift+T"
      }
    }
  }
}
